# Скопируйте в .env и заполните.
PORT=3001

# Сгенерировать: node -e "console.log(require('bcryptjs').hashSync('ваш-пароль', 10))"
ADMIN_PASSWORD_HASH=

# Любая длинная случайная строка. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Сколько последних версий каждого текстового блока хранить (для отката)
VERSIONS_TO_KEEP=20
